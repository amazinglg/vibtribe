<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/incoming_call_background"
    android:paddingLeft="28dp"
    android:paddingTop="48dp"
    android:paddingRight="28dp"
    android:paddingBottom="40dp">

    <ImageView
        android:id="@+id/caller_avatar"
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/incoming_call_avatar"
        android:clipToOutline="true"
        android:contentDescription="Caller profile photo"
        android:scaleType="centerCrop"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/call_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Incoming call"
        android:textColor="#D8C8FF"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/caller_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VibTribe"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="72dp">

        <Button
            android:id="@+id/btn_decline"
            android:layout_width="128dp"
            android:layout_height="60dp"
            android:text="Decline"
            android:textColor="#FFFFFF"
            android:backgroundTint="#E5484D"
            android:layout_marginEnd="24dp" />

        <Button
            android:id="@+id/btn_accept"
            android:layout_width="128dp"
            android:layout_height="60dp"
            android:text="Accept"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4ADE80" />
    </LinearLayout>
</LinearLayout>